# .gitignore for meshforge
# Generated by exodus/tools/gen-gitignore.mjs. Reviewed before any push.

# --- dependencies and build output ---
node_modules/
dist/
build/
out/
target/
.next/
.nuxt/
.turbo/
.parcel-cache/
*.tsbuildinfo

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/

# --- os and editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# --- credentials, never commit ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.pfx
*.key
id_rsa*
*.pat
credentials.json
.credentials.json
cookies.json
cookies*.json
secrets.json
secrets.yaml
secrets.yml
token.json
.exodus-pat*

# --- size: too large for git (GitHub rejects files over 100MB) ---
*.glb
*.obj
*.stl
*.ply
*.3mf
outputs/
meshes/
models/

# --- stray slicer run artifacts at repo root ---
result.json

# bench inputs (MIT, from trimesh/models)
!data/
!data/*.STL
!data/*.off
